# Shared secret for the preview bypass: /api/days?preview=<PREVIEW_SECRET>
# Server-only. Never prefix with NEXT_PUBLIC_ and never expose it to the client.
PREVIEW_SECRET=replace-with-a-long-random-string

# Optional support buttons, shown in the footer and at the bottom of every
# opened door. Each button appears only when its variable is non-empty (both
# set = side by side). Leave a variable empty to hide that button.
NEXT_PUBLIC_BUYMEACOFFEE_URL=https://buymeacoffee.com/yourname
NEXT_PUBLIC_PAYPAL_URL=https://paypal.me/yourname
